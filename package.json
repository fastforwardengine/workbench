{
	"name": "@fastforwardengine/workbench",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"description": "Workbench: an agentic lab workspace for electrical engineering, hardware, and electrochemistry.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fastforwardengine/workbench.git"
	},
	"homepage": "https://github.com/fastforwardengine/workbench#readme",
	"bugs": {
		"url": "https://github.com/fastforwardengine/workbench/issues"
	},
	"keywords": [
		"ambion",
		"agents",
		"lab",
		"terminal",
		"hardware"
	],
	"bin": {
		"workbench": "dist/main.mjs"
	},
	"files": [
		"dist",
		"library",
		"notes",
		"seed",
		"skills",
		"templates"
	],
	"engines": {
		"node": ">=26.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "node --experimental-ffi --disable-warning=ExperimentalWarning src/main.ts",
		"build": "tsdown",
		"release": "node scripts/release.ts",
		"check": "node scripts/check.ts",
		"format": "pnpm run format:lint && pnpm run format:style",
		"format:lint": "biome check . --write",
		"format:style": "prettier . --cache --write --list-different",
		"test": "vitest run",
		"test:live": "vitest run --config vitest.live.config.ts",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@ambionframework/ambion": "^0.5.0",
		"@ambionframework/assistant": "^0.5.0",
		"@ambionframework/journal": "^0.5.0",
		"@ambionframework/just-bash": "^0.5.0",
		"@ambionframework/pi": "^0.5.0",
		"@ambionframework/workspace": "^0.5.0",
		"@ambionframework/workstation": "^0.5.0",
		"@opentui/core": "0.5.11"
	},
	"devDependencies": {
		"@ambionframework/simulator": "^0.5.0",
		"@biomejs/biome": "^2.5.10",
		"@earendil-works/pi-ai": "^1.0.0",
		"@types/node": "^26.2.0",
		"knip": "^6.32.2",
		"prettier": "^3.9.6",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
