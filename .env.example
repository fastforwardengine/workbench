# Copy this file to .env for optional overrides. Never commit .env.
# Every seat runs on Codex. The default model is gpt-6-luna with low reasoning.
# WORKBENCH_MODEL=gpt-6-luna

# Run codex login to use the host ChatGPT login. A key takes precedence.
# CODEX_API_KEY=
# OPENAI_API_KEY also counts as a Codex credential.
# CODEX_HOME selects the host folder that holds auth.json.
# CODEX_HOME=/absolute/path/to/host-codex

# Live evals use a separate Pi judge. They make paid requests.
# JUDGE_MODEL=openai/gpt-6-luna
# OPENAI_API_KEY=

# The workspace bash and git backends run on this workstation over SSH.
# WORKBENCH_WORKSTATION=.workstation/workstation.json
