# Copy this file to .env and fill in real keys. Never commit .env.
#
# Every seat runs on Pi, on the model WORKBENCH_MODEL selects. Set a key below,
# or run `workbench login` to sign in with a ChatGPT Plus or Pro subscription.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# WORKBENCH_MODEL switches the model. "anthropic", "openai", "chatgpt", and "luna"
# are the named presets; any other value passes through as a full Pi model id,
# provider/model-id. With no value, the seats run on the chatgpt preset
# after `workbench login`, and on the anthropic preset before it.
# WORKBENCH_MODEL=anthropic
# WORKBENCH_MODEL=openai
# WORKBENCH_MODEL=chatgpt
# WORKBENCH_MODEL=luna

# WORKBENCH_PI_CREDENTIALS names the file that holds the sign-ins of
# `workbench login`. The default is ~/.ambion/pi/credentials.json.
# WORKBENCH_PI_CREDENTIALS=

# WORKBENCH_WORKSTATION names the workstation.json of a workstation. The bash
# and git backends of the workspace then run on it over SSH. Without it, both
# run on this machine. workstation/README.md starts a local one.
# WORKBENCH_WORKSTATION=.workstation/workstation.json
