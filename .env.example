# Copy this file to .env for optional overrides. Never commit .env.
# The assistant runs on Pi. The specialists run on Codex.
# The default model is gpt-6-luna with low reasoning. The assistant runs
# openai/gpt-6-luna on Pi.
# WORKBENCH_MODEL=gpt-6-luna

# Run workbench login for the ChatGPT sign-in of Pi. Pi prefers the stored sign-in.
# WORKBENCH_PI_CREDENTIALS=/absolute/path/to/credentials.json
# Run codex login for the ChatGPT sign-in of Codex. A key in the
# environment makes Codex bill the key.
# CODEX_API_KEY=
# OPENAI_API_KEY also counts as a Codex credential, and as a Pi credential.
# CODEX_HOME selects the host folder that holds auth.json.
# CODEX_HOME=/absolute/path/to/host-codex

# Live evals use a separate Pi judge. They make paid requests.
# JUDGE_MODEL=openai/gpt-6-luna
# OPENAI_API_KEY=

# The workspace bash and git backends run on this workstation over SSH.
# WORKBENCH_WORKSTATION=.workstation/workstation.json
