# Copy this file to .env and fill in real keys. Never commit .env.
#
# Every seat runs on Pi, on the model WORKBENCH_MODEL selects. Set both keys below
# to switch freely between the two presets in src/families.ts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# WORKBENCH_MODEL switches the model. "anthropic" and "openai" are the two named
# presets; anything else passes through as a full Pi model id,
# provider/model-id, for a provider this project has no preset for. The
# default is the anthropic preset.
# WORKBENCH_MODEL=anthropic
# WORKBENCH_MODEL=openai

# Workbench adds a person named for the account running it
# (src/definitions.ts), and opens straight to that person. Set WORKBENCH_USER to
# open as someone else instead.
# WORKBENCH_USER=priya
